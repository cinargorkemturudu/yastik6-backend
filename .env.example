# Shared secret the mobile app sends in the X-Mobile-Client-Key header (required)
ApiSettings__MobileClientKey=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Harem gold-price provider on RapidAPI (required)
Harem__ApiKey=YOUR_RAPIDAPI_KEY
# Provider-specific endpoint path from your RapidAPI subscription, e.g. /harem_altin/prices/<id> (required)
Harem__MarketPath=/harem_altin/prices/YOUR_ENDPOINT_ID

# Only used by docker-compose, for the bundled Seq log server
SEQ_ADMIN_PASSWORD=CHANGE_ME
